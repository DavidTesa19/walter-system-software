{
  "rewrites": [
    { "source": "/stahnout", "destination": "/stahnout.html" },
    { "source": "/stahnout/", "destination": "/stahnout.html" },
    { "source": "/:path([^.]+)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "**/*.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"walter-system.apk\"" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
