# Cloudflare Pages response headers (RAILWAY_COSTS.md step 7). The same rules
# as serve.json, which `npx serve` on Railway reads; keep the two in step until
# the Railway front-end is retired.

# The Android app downloads as a file, and a new build is never served stale.
/download/*
  Content-Disposition: attachment; filename="walter-system.apk"
  Cache-Control: no-cache

# Vite's hashed bundles never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
