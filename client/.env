# Frontend env (Vite reads variables prefixed with VITE_)
VITE_API_URL=http://localhost:3004
VITE_GOOGLE_CLIENT_ID=303422126374-t6oub4dvln30j0j38ckp9oobdgbgboeu.apps.googleusercontent.com

# Google Maps — powers the address dropdown on the subject "Lokalita" field.
# Create a key in Google Cloud with BOTH "Places API" and "Maps JavaScript API"
# enabled, and restrict it by HTTP referrer to this app's domains. Left empty,
# Lokalita stays an ordinary free-text field.
VITE_GOOGLE_MAPS_API_KEY=
