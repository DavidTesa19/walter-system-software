# Frontend env (Vite reads variables prefixed with VITE_)
VITE_API_URL=http://localhost:3004

# Google Maps — powers the address dropdown and the "Vybrat na mapě" picker on
# the subject "Lokalita" field, which also fill in the Kraj and store the
# coordinates of the chosen place.
# Create a key in Google Cloud with "Places API", "Maps JavaScript API" and
# "Geocoding API" enabled (the last one is what names a pin dropped on the map),
# and restrict it by HTTP referrer to this app's domains. Left empty, Lokalita
# stays an ordinary free-text field.
VITE_GOOGLE_MAPS_API_KEY=
