# Environment Configuration
# Copy this file to .env and fill in your values

# Node Environment (development, production)
NODE_ENV=development

# Server Port
PORT=3004

# Database Configuration
# Leave empty for local JSON file database
# Set to PostgreSQL connection string for production
# Example: postgresql://user:password@host:5432/database
DATABASE_URL=

# Railway Production Database (for syncing data)
# Get this from your Railway PostgreSQL service
RAILWAY_DATABASE_URL=

# CORS Configuration
# Leave empty for local development (allows all origins)
# Set to your frontend URL in production
# Example: https://your-app.railway.app
ALLOWED_ORIGIN=

# Optional explicit app URL used in email notifications.
# If empty, the server falls back to ALLOWED_ORIGIN.
APP_BASE_URL=

# Data Directory (for JSON file mode)
DATA_DIR=./data

# Seed File (for JSON file mode)
SEED_FILE=./db.json

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional fallback recipients for public submission notifications.
# Comma-separated, for example: founder@example.com,cofounder@example.com
PUBLIC_SUBMISSION_NOTIFY_TO=

# SMTP mail delivery configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Analýza > Finance: read-only access to the providers' real bills.
# All optional; a provider without one shows as "Nepotvrzeno" on the screen.
# Anthropic: Claude Console > Settings > Admin keys (organisations only).
ANTHROPIC_ADMIN_KEY=
# OpenAI: platform.openai.com > Settings > Organization > Admin keys.
OPENAI_ADMIN_KEY=
# Railway: Account Settings > Tokens, workspace "No workspace" (account token).
RAILWAY_API_TOKEN=
# Optional: limit Railway to one workspace.
RAILWAY_WORKSPACE_ID=
# Cloudflare: API token with Account > Billing > Read, plus the account ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Google Cloud (Maps): BigQuery billing export. Service account JSON key (raw
# or base64) with BigQuery Data Viewer + Job User, and the export table as
# project.dataset.gcp_billing_export_v1_...
GOOGLE_BILLING_SERVICE_ACCOUNT=
GOOGLE_BILLING_EXPORT_TABLE=
