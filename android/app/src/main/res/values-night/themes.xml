<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A dark theme at night: since Android 13 the WebView reports
         prefers-color-scheme from the app theme, so this is what lets the site
         follow the phone's dark mode. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>
</resources>
