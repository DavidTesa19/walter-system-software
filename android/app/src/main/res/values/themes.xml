<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: the page is the whole screen. The purple window
         background is what shows while the page loads. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>
</resources>
